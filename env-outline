# Copy this file to `.env` in the project root and fill in the values.
# `.env` is gitignored -- never commit real credentials.

# ---------------------------------------------------------------------------
# Browser config (PUBLIC_*) -- baked into the client bundle
# ---------------------------------------------------------------------------
# Firebase console -> Project settings -> Your apps -> SDK setup and config.
#
# These are NOT secrets and cannot be hidden: the browser has to send them to
# reach the right Firebase project, so they are visible in devtools no matter
# what you do. Security comes from firestore.rules / database.rules.json and
# from the server verifying every ID token -- not from concealing these.
#
# Only Auth is initialised in the browser, so this is the complete list.
# (No storageBucket / messagingSenderId / appId: we load no Storage, no Cloud
# Messaging and no Firebase Analytics.)
PUBLIC_FIREBASE_API_KEY=your-api-key
PUBLIC_FIREBASE_AUTH_DOMAIN=your-app.firebaseapp.com
PUBLIC_FIREBASE_PROJECT_ID=your-app-id

# Used by the server to reach the Realtime Database.
PUBLIC_FIREBASE_DATABASE_URL=https://your-app.firebaseio.com

# ---------------------------------------------------------------------------
# Server credentials -- REQUIRED for /api to work. THIS ONE IS A SECRET.
# ---------------------------------------------------------------------------
# Grants full read/write to the project and bypasses all security rules.
#
# Needed whenever Application Default Credentials are unavailable:
#   Cloud Functions / Cloud Run / Firebase App Hosting -> not needed (ADC)
#   Vercel / Netlify / anywhere else                   -> required
#   Local dev against the real project                 -> this, or ADC via
#                                                         gcloud auth application-default login
#   Local dev against the emulators                    -> not needed
#
# Firebase console -> Project settings -> Service accounts
#   -> Generate new private key, then flatten it onto one line:
#        jq -c . ~/Downloads/your-key.json
#
# When set, the project id is read from inside this key, so
# PUBLIC_FIREBASE_PROJECT_ID becomes a fallback rather than a requirement.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# ---------------------------------------------------------------------------
# Local emulator development (optional)
# ---------------------------------------------------------------------------
# `npm run dev:local` sets all of these for you. Listed here for reference.
# VITE_FIREBASE_EMULATORS=true
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_DATABASE_EMULATOR_HOST=127.0.0.1:9000
